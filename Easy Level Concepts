Isomorphic Strings                               LC:205
class Solution:
    def isIsomorphic(self, s: str, t: str) -> bool:
         map1={}
         map2={}

         for i in range(len(s)):
            c1=s[i]
            c2=t[i]

            if c1 in map1:
                if map1[c1] != c2:
                    return False
            else:
                map1[c1] = c2

            if c2 in map2:
                if map2[c2] != c1:
                    return False
            else:
                map2[c2] = c1

         return True 

Best Time to Buy and Sell Stock                    LC:121
class Solution:
    def maxProfit(self, prices: List[int]) -> int:
        min_price = float('inf')
        max_profit = 0
        for current_price in prices:
            min_price = min(current_price, min_price)
            max_profit = max(max_profit, current_price - min_price)   
        return max_profit

Move Zeros                                         LC:283
class Solution:
    def moveZeroes(self, nums: List[int]) -> None:
        j=0
        for i in range(len(nums)):
            if nums[i]:
                nums[i],nums[j] = nums[j],nums[i]
                j+=1
        return nums 

Find All Numbers Disappered in Array                LC:448
class Solution:
    def findDisappearedNumbers(self, nums: List[int]) -> List[int]:
        seen=set(nums)
        res=[]
        for i in range(1,len(nums)+1):
            if i not in seen:
                res.append(i)
        return res

Add Digits:                                         LC:258
class Solution:
    def addDigits(self, num: int) -> int:
        while num >= 10:
            count = 0
            while num > 0:
                last_digit = num % 10
                count += last_digit
                num = num // 10
        
            num = count
        return num

Distribute Elements Into Two Arrays I                LC:3069
class Solution(object):
    def resultArray(self, nums):
        """
        :type nums: List[int]
        :rtype: List[int]
        """
        arr1 = [nums[0]]
        arr2 = [nums[1]]
        n = len(nums)
        for i in range(2, n):
            if arr1[-1] > arr2[-1]:
                arr1.append(nums[i])
            else:
                arr2.append(nums[i])

        return arr1 + arr2

