class Solution:
    def containsDuplicate(self, nums: List[int]) -> bool:
        seen=set()
        for num in nums:
            if num in seen:
                return True
            seen.add(num)
        
        return False     

Check Divisibility by Digit Sum and Product         LC:3622
class Solution:
    def checkDivisibility(self, n: int) -> bool:
        s, p, x=0, 1, n
        while x>0:
            x, r=divmod(x, 10)
            s+=r
            p*=r
        return n%(s+p)==0

                     
